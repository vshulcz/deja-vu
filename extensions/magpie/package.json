{
  "name": "@vshulcz/magpie-deja",
  "version": "0.24.3",
  "description": "Local MCP memory and project-scoped session history recall for Claude Code, Codex, Cursor, and other coding agents behind the Magpie gateway.",
  "type": "module",
  "files": [
    "deja.hooks.mjs",
    "deja.lib.mjs",
    "docs/zh.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vshulcz/deja-vu.git",
    "directory": "extensions/magpie"
  },
  "homepage": "https://vshulcz.github.io/deja-vu/guide/switch-agents-without-losing-context.html",
  "bugs": {
    "url": "https://github.com/vshulcz/deja-vu/issues"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-gateway",
    "deja-vu",
    "memory",
    "recall",
    "session-history",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "opencode",
    "hermes",
    "claude",
    "code",
    "mcp",
    "mcp-server",
    "session",
    "history",
    "search"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@vshulcz/deja-vu": "^0.24.3"
  },
  "magpie": {
    "hooks": "./deja.hooks.mjs",
    "options": {
      "requestTimeoutMs": 800,
      "maxBytes": 4000,
      "recallRemote": false,
      "allowUnscoped": false
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/vshulcz/deja-vu"
