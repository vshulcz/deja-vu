{
  "name": "deja",
  "version": "0.25.1",
  "description": "deja-vu memory for Kimi Code: recall the sessions your other coding agents already wrote — Claude Code, Codex, Cursor, opencode and forty-nine more, including work from before it was installed.",
  "keywords": [
    "memory",
    "recall",
    "sessions",
    "search",
    "history"
  ],
  "author": "vshulcz",
  "homepage": "https://vshulcz.github.io/deja-vu/guide/memory-for-kimi.html",
  "license": "MIT",
  "interface": {
    "displayName": "deja",
    "shortDescription": "Search your own past AI coding sessions, from every tool on this machine.",
    "longDescription": "deja indexes the session files coding agents already write to disk — Claude Code, Codex, Cursor, opencode, Gemini, Zed and more — and answers from them. Ask what you fixed before instead of debugging it twice. The index is local: no LLM, no embeddings, no network path besides a daily release check, which DEJA_OFFLINE=1 turns off. Needs the deja binary: https://github.com/vshulcz/deja-vu",
    "developerName": "vshulcz",
    "websiteURL": "https://github.com/vshulcz/deja-vu"
  },
  "skills": "./skills/",
  "commands": "./commands/",
  "sessionStart": {
    "skill": "deja-history"
  },
  "mcpServers": {
    "deja": {
      "command": "node",
      "args": [
        "./bin/deja-mcp.mjs"
      ]
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "node ./hooks/recall.mjs hook-context --kimi",
      "timeout": 30
    },
    {
      "event": "UserPromptSubmit",
      "command": "node ./hooks/recall.mjs hook-context --plain --once",
      "timeout": 30
    },
    {
      "event": "UserPromptSubmit",
      "command": "node ./hooks/recall.mjs hook-prompt --plain",
      "timeout": 30
    },
    {
      "event": "PreCompact",
      "command": "node ./hooks/recall.mjs hook-precompact --harness kimi",
      "timeout": 30
    },
    {
      "event": "SessionEnd",
      "command": "node ./hooks/recall.mjs hook-session-end",
      "timeout": 30
    },
    {
      "event": "Stop",
      "command": "node ./hooks/recall.mjs hook-session-end",
      "timeout": 30
    },
    {
      "event": "PreToolUse",
      "matcher": "^mcp__deja__",
      "command": "node ./hooks/recall.mjs hook-mcp-call",
      "timeout": 30
    },
    {
      "event": "PostToolUse",
      "matcher": "^(Edit|Write|Bash)$",
      "command": "node ./hooks/recall.mjs hook-tool-after --kimi",
      "timeout": 30
    },
    {
      "event": "PostToolUseFailure",
      "matcher": "Bash",
      "command": "node ./hooks/recall.mjs hook-tool-after --kimi",
      "timeout": 30
    },
    {
      "event": "PreToolUse",
      "matcher": "^(Edit|Write)$",
      "command": "node ./hooks/recall.mjs hook-tool --defer",
      "timeout": 30
    }
  ]
}
