{
  "name": "dsh-deja",
  "version": "0.24.1",
  "description": "deja-vu memory for DeepSeek Harness: the session history of forty-three other coding agents, searchable and recalled before each step — a local index, no LLM.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib.js",
    "search.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "docs/zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vshulcz/deja-vu.git",
    "directory": "extensions/dsh"
  },
  "homepage": "https://vshulcz.github.io/deja-vu/guide/memory-for-dsh.html",
  "bugs": {
    "url": "https://github.com/vshulcz/deja-vu/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "recall",
    "session-history",
    "migration",
    "agent-memory",
    "ai-memory",
    "coding-agent",
    "claude-code",
    "claude-code-memory",
    "codex",
    "cursor",
    "gemini-cli",
    "mcp",
    "mcp-server",
    "session-search",
    "local-first"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2",
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "dependencies": {
    "@vshulcz/deja-vu": "^0.24.1"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/vshulcz/deja-vu"
  }
}
