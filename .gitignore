# Where story.py drops the film's frames when it is run without --out. Three
# hundred and twenty PNGs, one run.
/scripts/demo/frames/

# Python leaves these beside every script it runs, and there is Python in
# scripts/ and tools/. Nothing ignored them, so they were committable as
# binaries by anyone who ran one.
__pycache__/
*.pyc

# extensions/ builds where its ecosystem builds: cargo in the Zed extension,
# npm in the two plugin packages. None of it is ours to commit.
extensions/zed/target/
extensions/zed/Cargo.lock
extensions/jetbrains/.gradle/
extensions/jetbrains/build/
extensions/jetbrains/.intellijPlatform/
extensions/*/node_modules/
extensions/*/*.tgz
extensions/*/package-lock.json
# a test run that starts deja from cmd/deja writes its state dir there
/cmd/deja/deja/

# What a local `go test` and a local npm run leave behind, and what Finder
# leaves in every directory it has been asked to show.
coverage.out
*.prof
/node_modules/
.DS_Store

# deja's own state files, which sit beside the index: running the binary with
# DEJA_INDEX_DIR pointing at a checkout drops them in it. `.hookseen` has been
# sitting untracked in a working copy since September, and `.live` is new in
# 0.21.2 and lands the same way.
.hookseen
.hookcache-*
.warmup
.live
