# The line-level blame demo. Render with:
#
#   go run ./scripts/demo -out /tmp/demo-home -fill 60 -blame
#   rm -rf /tmp/demo-home/.cache/deja
#   vhs scripts/demo/blame.tape
#   cp assets/blame.gif docs/assets/blame.gif
#
# The copy is not optional: the README reads from assets/ and the site is
# served from docs/, so both hold the recording.
#
# One beat, because the whole point is a comparison the viewer makes in two
# seconds: git names a commit and a person, and that is all git can do. deja
# names the session that made that commit, what the line said before, and the
# question it was answering — which is the part nobody writes down.
#
# The repository and the session are both synthetic, generated by -blame. A
# demo of attribution recorded against a real checkout would publish someone's
# code and their prompts in the same frame.

Output assets/blame.gif

Set Shell zsh
Set FontSize 17
Set Width 1200
Set Height 300
Set Padding 24
Set TypingSpeed 40ms
Set Framerate 24

Hide
Type "export HOME=/tmp/demo-home PATH=/tmp/demobin:$PATH PS1='$ '"
Enter
Type "cd /tmp/demo-home/work/checkout"
Enter
# Warm the index here rather than in the frame. Under this HOME the stores are
# not the ones the prepared index was built from, so the first search would
# rebuild — twelve lines of progress on top of the answer.
Type "deja index >/dev/null 2>&1"
Enter
Sleep 20s
Type "clear"
Enter
Show

Sleep 800ms

# What the repository can say on its own.
Type "git blame -L 17,17 --date=short internal/pool/pool.go"
Sleep 400ms
Enter
Sleep 3s

# What the history of the agents adds: the session, the previous text, the ask.
Type "deja blame internal/pool/pool.go:17 | head -6"
Sleep 400ms
Enter
Sleep 7s
